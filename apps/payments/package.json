{
  "name": "@restaurante/payments",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "PAYMENTS_REPOSITORY_INTEGRATION=1 vitest run src/infrastructure/persistence/drizzle/drizzle-payment-repository.integration.spec.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.13.4",
    "@grpc/proto-loader": "^0.7.15",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@restaurante/contracts": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/node": "^22.10.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "~5.7.2",
    "vitest": "^5.0.3"
  }
}
