{
  "name": "restaurante",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "node scripts/pm2-root.mjs start",
    "dev:stop": "node scripts/pm2-root.mjs stop",
    "dev:restart": "node scripts/pm2-root.mjs restart",
    "dev:status": "node scripts/pm2-root.mjs status",
    "dev:logs": "node scripts/pm2-root.mjs logs",
    "dev:plain": "pnpm -r --parallel --filter @restaurante/api --filter @restaurante/web run dev",
    "dev:api": "pnpm --filter @restaurante/api dev",
    "dev:web": "pnpm --filter @restaurante/web dev",
    "build": "pnpm -r --filter @restaurante/api --filter @restaurante/web run build",
    "typecheck": "pnpm -r --filter @restaurante/api --filter @restaurante/web run typecheck",
    "lint": "pnpm -r --filter @restaurante/api --filter @restaurante/web run lint"
  },
  "devDependencies": {
    "pm2": "6.0.14"
  },
  "engines": {
    "node": ">=20"
  }
}
